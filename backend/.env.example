# Backend configuration (all optional)
TEMP_ROOT=temporary

# Upload / input limits
MAX_TEMPLATE_SIZE_MB=25
MAX_SPREADSHEET_SIZE_MB=10
MAX_NAMES=2000
MAX_NAME_LENGTH=120
MAX_TOTAL_OUTPUT_MB=1024

# Preview rendering
PREVIEW_DPI=110
PREVIEW_MAX_PIXELS=1600
TEMP_TTL_SECONDS=21600

# CORS: extra explicit origins (appended to the built-in allowlist).
# Wildcards are ignored because credentials are enabled.
CORS_ORIGINS=
# Regex for dynamic hosts, e.g. Vercel preview deployments.
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
